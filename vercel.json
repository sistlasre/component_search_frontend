{
  "headers": [
    {
      "source": "/cart",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/checkout",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/orders",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/contact/:contactId",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/contact/:contactId/download",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/contacts/(.*).vcf",
      "headers": [
        { "key": "Content-Type", "value": "text/vcard; charset=utf-8" },
        { "key": "X-Robots-Tag", "value": "noindex, nofollow" }
      ]
    }
  ],
  "functions": {
    "api/part-prerender.js": {
      "includeFiles": "build/index.html"
    },
    "api/contact-download.js": {
      "includeFiles": "build/contacts/**"
    }
  },
  "rewrites": [
    {
      "source": "/part/:partId",
      "destination": "/api/part-prerender?partId=:partId"
    },
    {
      "source": "/contact/:contactId",
      "destination": "/api/contact-download?contactId=:contactId"
    },
    {
      "source": "/api/cs/:path*",
      "destination": "https://obkg1pw61g.execute-api.us-west-2.amazonaws.com/prod/cs/:path*"
    },
    {
      "source": "/api/:path*",
      "destination": "https://e1hygwwcle.execute-api.us-west-2.amazonaws.com/dev/:path*"
    }
  ]
}
